# Example configuration for the envguard demo.

# envguard: url
DATABASE_URL=

# envguard: port
PORT=8000

# envguard: bool
DEBUG=false

# envguard: choices=dev|staging|prod
APP_ENV=dev

# envguard: float
REQUEST_TIMEOUT=10.5

# Secret used to sign sessions. Any non-empty string.
SECRET_KEY=

# envguard: optional url
SENTRY_DSN=
